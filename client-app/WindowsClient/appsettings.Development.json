{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "ServiceSettings": {
    "ApiBaseUrl": "http://localhost:5000",
    "HeartbeatIntervalSeconds": 30,
    "BackupCheckIntervalMinutes": 1
  }
}